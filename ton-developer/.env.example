# TON Developer Hermes - Environment Variables
# Copy to ~/.hermes/profiles/ton-developer/.env and fill in your values

# === TON Center API (Required) ===
# Get your API key from https://toncenter.com
TONCENTER_API_KEY=your_toncenter_api_key_here
TONCENTER_BASE_URL=https://testnet.toncenter.com/api/v2/

# === TonAPI (Alternative) ===
# Get from https://tonapi.io
TONAPI_API_KEY=your_tonapi_key_here

# === Wallet Seed Phrases ===
# NEVER commit these to version control!
# Use separate wallets for testnet and mainnet
TON_TESTNET_MNEMONIC=""
TON_MAINNET_MNEMONIC=""

# === TON CLI ===
# Path to toncli (if not in PATH)
TONCLI_PATH=/usr/local/bin/toncli

# === Project Settings ===
# Auto-detected project root for toncli
TONCLI_PROJECT_ROOT=.

# === Network ===
# Set to 'testnet' or 'mainnet'
TON_DEFAULT_NETWORK=testnet
